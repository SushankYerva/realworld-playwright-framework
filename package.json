{
  "name": "realworld-playwright-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:anonymous": "playwright test --project=chromium-anonymous",
    "test:authenticated": "playwright test --project=chromium-authenticated",
    "test:articles": "playwright test tests/ui/authenticated/article-lifecycle.spec.ts --project=chromium-authenticated",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report reports/html",
    "typecheck": "tsc --noEmit"
    
  },
  "keywords": [],
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1"
  },
  "dependencies": {
    "typescript": "^7.0.2"
  }
}
